APP_NAME=marketmind-oecd
APP_ENV=local
# 8001 when running all 5 MarketMind services together (pytrends=8000,
# oecd=8001, undata=8002, worldbank=8003, core=8004).
APP_PORT=8001
APP_VERSION=0.1.0

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=marketmind_oecd
DATABASE_USER=marketmind
DATABASE_PASSWORD=admin

# TLS da conexão Postgres: disable | require | verify-full.
# "disable" para o docker-compose local (sem listener TLS). O Azure Database
# for PostgreSQL Flexible Server recusa conexão em texto puro
# (require_secure_transport = ON), então lá precisa ser "require" no mínimo.
DATABASE_SSL_MODE=disable

OECD_BASE_URL=https://sdmx.oecd.org/public/rest/v1
DEFAULT_TIMEOUT=60
DEFAULT_RETRIES=5
DEFAULT_BACKOFF=2

LOG_LEVEL=INFO
